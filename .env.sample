# OpenAI API key (server-side only; never expose this to the browser)
OPENAI_API_KEY=your-openai-api-key

# OpenAI model used for image reading and tutoring
OPENAI_MODEL=gpt-5.4-mini

# Local API settings
AP_TUTOR_HOST=127.0.0.1
AP_TUTOR_PORT=8000
# Optional bearer token required by the local screenshot agent. Leave blank for local development.
AP_TUTOR_API_TOKEN=
# Optional override for the operating system's screenshot output directory.
AP_TUTOR_SCREENSHOT_DIR=

# SQLite database and saved image directory
AP_TUTOR_DATA_DIR=./data
AP_TUTOR_MAX_UPLOAD_MB=12
